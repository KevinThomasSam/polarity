# Runtime mode; Next.js sets this for its commands, and this development placeholder is safe for direct scripts.
NODE_ENV=development
# Reserved for the managed PostgreSQL adapter; currently validated but not used because local PGlite remains the active database.
DATABASE_URL=postgresql://polarity_user:replace-with-password@localhost:5432/polarity
# Public canonical application URL; required for production startup validation.
NEXT_PUBLIC_APP_URL=http://localhost:3000
